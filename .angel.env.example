# Copy to .angel.env and fill in. That file is gitignored and must stay so.
#
# Angel One SmartAPI — create an app at https://smartapi.angelbroking.com
ANGEL_API_KEY=your_api_key
ANGEL_API_SECRET=your_api_secret
ANGEL_CLIENT_ID=your_client_code
ANGEL_PIN=your_login_pin
# Base32 TOTP seed shown when you enable 2FA. Treat it like a password.
ANGEL_TOTP_SECRET=your_totp_seed

# Telegram — talk to @BotFather for the token, @userinfobot for the chat id
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# The loader also accepts the ANGLE_ONE_* spellings used by older configs.
